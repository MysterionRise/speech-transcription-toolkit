# Ship the unit tests in the sdist (setuptools alone would skip conftest.py), and the checkout shims that they run.
recursive-include tests *.py
include main.py convert.py
# The integration tests download models and transcribe the samples in tests/data: they run from a checkout.
prune tests/integration
prune tests/data
# The benchmark harness runs from a checkout too, and downloads its evaluation set.
prune benchmarks
exclude tests/test_benchmarks.py
